/* ============================================================
   3. HELPERS
   ============================================================ */
$SELF = $_SERVER['PHP_SELF'] ?? 'index.php';

function e($v) { return htmlspecialchars((string)($v ?? ''), ENT_QUOTES, 'UTF-8'); }

function url($page = 'home', array $params = []) {
    global $SELF;
    $q = array_merge(['page' => $page], $params);
    return $SELF . '?' . http_build_query($q);
}
function redirect_to($page, array $params = []) {
    header('Location: ' . url($page, $params));
    exit;
}
function is_logged_in(): bool { return !empty($_SESSION['user_id']); }
function is_admin(): bool     { return (($_SESSION['role'] ?? '') === 'admin'); }

function require_login() {
    if (!is_logged_in()) { flash('Please log in first.'); redirect_to('login'); }
}
function require_admin() {
    if (!is_logged_in()) { flash('Please log in as an administrator.'); redirect_to('login'); }
    if (!is_admin())     { flash('Administrator access only.'); redirect_to('home'); }
}
function flash($msg = null) {
    if ($msg === null) { $m = $_SESSION['flash'] ?? null; unset($_SESSION['flash']); return $m; }
    $_SESSION['flash'] = $msg;
}
function csrf_token(): string {
    if (empty($_SESSION['csrf'])) $_SESSION['csrf'] = bin2hex(random_bytes(16));
    return $_SESSION['csrf'];
}
function csrf_field(): string {
    return '<input type="hidden" name="csrf" value="' . e(csrf_token()) . '">';
}
function csrf_check() {
    if (!hash_equals($_SESSION['csrf'] ?? '', $_POST['csrf'] ?? '')) {
        http_response_code(419);
        die('Invalid security token. Go back and try again.');
    }
}

/* ============================================================
   4. ROUTE + PAGE TITLE
   ============================================================ */
$page = $_GET['page'] ?? 'home';
$pageTitles = [
    'home'             => 'Home',
    'register'         => 'Register',
    'login'            => 'Login',
    'modules'          => 'Learning Modules',
    'module'           => 'Module',
    'tips'             => 'Safety Tips',
    'quiz'             => 'Quizzes',
    'my_results'       => 'My Results',
    'admin'            => 'Admin Dashboard',
    'admin_modules'    => 'Manage Modules',
    'admin_tips'       => 'Manage Tips',
    'admin_quizzes'    => 'Manage Quizzes',
    'admin_questions'  => 'Manage Questions',
];
$pageTitle = $pageTitles[$page] ?? 'CyberSafe';

/* ============================================================
   5. POST HANDLERS
   ============================================================ */
if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    /* -------- REGISTER -------- */
    if ($page === 'register') {
        csrf_check();
        $name  = trim($_POST['name']  ?? '');
        $email = trim($_POST['email'] ?? '');
        $pass  = $_POST['password']  ?? '';
        $pass2 = $_POST['password2'] ?? '';
        $errs = [];

        if (mb_strlen($name) < 2)                 $errs[] = 'Please enter your full name.';
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) $errs[] = 'Please enter a valid email.';
        if (strlen($pass) < 8)                    $errs[] = 'Password must be at least 8 characters.';
        if ($pass !== $pass2)                     $errs[] = 'Passwords do not match.';

        if (!$errs) {
            $st = $pdo->prepare('SELECT id FROM users WHERE email = ?');
            $st->execute([$email]);
            if ($st->fetch()) $errs[] = 'That email is already registered.';
        }
        if ($errs) {
            $_SESSION['register_errors'] = $errs;
            $_SESSION['register_old']    = ['name' => $name, 'email' => $email];
        } else {
            $st = $pdo->prepare('INSERT INTO users (name, email, password_hash) VALUES (?,?,?)');
            $st->execute([$name, $email, password_hash($pass, PASSWORD_DEFAULT)]);
            flash('Account created successfully. You may now log in.');
            redirect_to('login');
        }
        redirect_to('register');
    }

    /* -------- LOGIN -------- */
    if ($page === 'login') {
        csrf_check();
        $email = trim($_POST['email'] ?? '');
        $pass  = $_POST['password'] ?? '';
        $st = $pdo->prepare('SELECT * FROM users WHERE email = ?');
        $st->execute([$email]);
        $u = $st->fetch();
        if ($u && password_verify($pass, $u['password_hash'])) {
            session_regenerate_id(true);
            $_SESSION['user_id'] = (int)$u['id'];
            $_SESSION['name']    = $u['name'];
            $_SESSION['role']    = $u['role'];
            flash('Welcome back, ' . $u['name'] . '!');
            redirect_to(is_admin() ? 'admin' : 'home');
        }
        $_SESSION['login_error'] = 'Incorrect email or password.';
        $_SESSION['login_old']   = $email;
        redirect_to('login');
    }

    /* -------- QUIZ SUBMIT -------- */
    if ($page === 'quiz' && isset($_POST['quiz_id'])) {
        csrf_check();
        $quizId = (int)$_POST['quiz_id'];
        $st = $pdo->prepare('SELECT * FROM quizzes WHERE id = ?');
        $st->execute([$quizId]);
        $quiz = $st->fetch();
        if (!$quiz) { flash('Quiz not found.'); redirect_to('quiz'); }

        $st = $pdo->prepare('SELECT * FROM questions WHERE quiz_id = ? ORDER BY id');
        $st->execute([$quizId]);
        $questions = $st->fetchAll();

        $answers = is_array($_POST['q'] ?? null) ? $_POST['q'] : [];
        $score = 0; $review = [];
        foreach ($questions as $q) {
            $given = strtoupper(trim((string)($answers[$q['id']] ?? '')));
            $ok    = ($given === strtoupper($q['correct_option']));
            if ($ok) $score++;
            $review[] = ['q' => $q, 'given' => $given, 'ok' => $ok];
        }
        $total = count($questions);

        if (is_logged_in() && $total > 0) {
            $pdo->prepare('INSERT INTO results (user_id, quiz_id, score, total) VALUES (?,?,?,?)')
                ->execute([$_SESSION['user_id'], $quizId, $score, $total]);
        }
        $_SESSION['quiz_result'] = compact('quiz', 'score', 'total', 'review');
        redirect_to('quiz', ['result' => 1]);
    }

    /* -------- ADMIN: MODULES -------- */
    if ($page === 'admin_modules') {
        require_admin(); csrf_check();
        $action = $_POST['action'] ?? '';
        if ($action === 'save') {
            $id      = (int)($_POST['id'] ?? 0);
            $title   = trim($_POST['title']   ?? '');
            $content = trim($_POST['content'] ?? '');
            if ($title === '' || $content === '') {
                flash('Title and content are required.');
            } elseif ($id > 0) {
                $pdo->prepare('UPDATE modules SET title=?, content=? WHERE id=?')
                    ->execute([$title, $content, $id]);
                flash('Module updated.');
            } else {
                $pdo->prepare('INSERT INTO modules (title, content) VALUES (?,?)')
                    ->execute([$title, $content]);
                flash('Module added.');
            }
        } elseif ($action === 'delete') {
            $pdo->prepare('DELETE FROM modules WHERE id = ?')->execute([(int)$_POST['id']]);
            flash('Module deleted.');
        }
        redirect_to('admin_modules');
    }

    /* -------- ADMIN: TIPS -------- */
    if ($page === 'admin_tips') {
        require_admin(); csrf_check();
        $action = $_POST['action'] ?? '';
        if ($action === 'save') {
            $id       = (int)($_POST['id'] ?? 0);
            $category = trim($_POST['category'] ?? '');
            $tip      = trim($_POST['tip']      ?? '');
            if ($category === '' || $tip === '') {
                flash('Category and tip are required.');
            } elseif ($id > 0) {
                $pdo->prepare('UPDATE tips SET category=?, tip=? WHERE id=?')
                    ->execute([$category, $tip, $id]);
                flash('Tip updated.');
            } else {
                $pdo->prepare('INSERT INTO tips (category, tip) VALUES (?,?)')
                    ->execute([$category, $tip]);
                flash('Tip added.');
            }
        } elseif ($action === 'delete') {
            $pdo->prepare('DELETE FROM tips WHERE id = ?')->execute([(int)$_POST['id']]);
            flash('Tip deleted.');
        }
        redirect_to('admin_tips');
    }

    /* -------- ADMIN: QUIZZES -------- */
    if ($page === 'admin_quizzes') {
        require_admin(); csrf_check();
        $action = $_POST['action'] ?? '';
        if ($action === 'save') {
            $id          = (int)($_POST['id'] ?? 0);
            $title       = trim($_POST['title']       ?? '');
            $description = trim($_POST['description'] ?? '');
            if ($title === '') {
                flash('Quiz title is required.');
            } elseif ($id > 0) {
                $pdo->prepare('UPDATE quizzes SET title=?, description=? WHERE id=?')
                    ->execute([$title, $description, $id]);
                flash('Quiz updated.');
            } else {
                $pdo->prepare('INSERT INTO quizzes (title, description) VALUES (?,?)')
                    ->execute([$title, $description]);
                flash('Quiz added.');
            }
        } elseif ($action === 'delete') {
            $pdo->prepare('DELETE FROM quizzes WHERE id = ?')->execute([(int)$_POST['id']]);
            flash('Quiz deleted.');
        }
        redirect_to('admin_quizzes');
    }

    /* -------- ADMIN: QUESTIONS -------- */
    if ($page === 'admin_questions') {
        require_admin(); csrf_check();
        $action = $_POST['action'] ?? '';
        $quizId = (int)($_POST['quiz_id'] ?? 0);

        if ($action === 'save') {
            $id   = (int)($_POST['id'] ?? 0);
            $row  = [
                trim($_POST['question'] ?? ''),
                trim($_POST['option_a'] ?? ''),
                trim($_POST['option_b'] ?? ''),
                trim($_POST['option_c'] ?? ''),
                trim($_POST['option_d'] ?? ''),
                strtoupper(trim($_POST['correct_option'] ?? 'A')),
            ];
            if (in_array('', $row, true)) {
                flash('All fields are required.');
            } elseif (!in_array($row[5], ['A','B','C','D'], true)) {
                flash('Correct answer must be A, B, C or D.');
            } elseif ($id > 0) {
                $pdo->prepare('UPDATE questions SET question=?, option_a=?, option_b=?,
                               option_c=?, option_d=?, correct_option=?
                               WHERE id=? AND quiz_id=?')
                    ->execute([...$row, $id, $quizId]);
                flash('Question updated.');
            } else {
                $pdo->prepare('INSERT INTO questions
                    (question, option_a, option_b, option_c, option_d, correct_option, quiz_id)
                    VALUES (?,?,?,?,?,?,?)')
                    ->execute([...$row, $quizId]);
                flash('Question added.');
            }
        } elseif ($action === 'delete') {
            $pdo->prepare('DELETE FROM questions WHERE id = ? AND quiz_id = ?')
                ->execute([(int)$_POST['id'], $quizId]);
            flash('Question deleted.');
        }
        redirect_to('admin_questions', ['quiz_id' => $quizId]);
    }
}

